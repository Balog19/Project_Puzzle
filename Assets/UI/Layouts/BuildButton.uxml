<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- BuildButton.uxml: one building in a build tray: icon tile (sprite, or first-letter placeholder),
         name and cost. Set up by BuildButtonWidget. -->
    <ui:Button name="button" class="build-button">
        <ui:VisualElement name="icon" class="build-button__icon" picking-mode="Ignore">
            <ui:Label name="icon-letter" text="B" class="build-button__icon-letter" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="name" text="Building" class="label build-button__name" picking-mode="Ignore" />
        <ui:Label name="cost" text="5 Wood" class="label label--dim build-button__cost" picking-mode="Ignore" />
    </ui:Button>
</ui:UXML>
