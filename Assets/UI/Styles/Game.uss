/*
 * Game.uss: the one stylesheet for the whole HUD.
 * Change the variables below to restyle everything at once.
 * Naming: .block, .block__part, .block--variant (BEM), matching the class names in the UXML layouts.
 */

:root {
    --panel-bg: rgba(18, 22, 28, 0.88);
    --panel-border: rgba(255, 255, 255, 0.12);
    --text: rgb(236, 236, 236);
    --text-dim: rgb(165, 172, 182);
    --accent: rgb(240, 190, 60);
    --bar-bg: rgba(255, 255, 255, 0.12);
    --bar-fill: rgb(110, 190, 90);
    --negative: rgb(235, 95, 85);
    --button-bg: rgba(40, 46, 56, 0.95);
    --button-hover: rgba(60, 68, 82, 0.95);
    --radius: 6px;
    --edge: 16px;
}

/* ---------- Shared ---------- */

.hud {
    flex-grow: 1;
}

.panel {
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: var(--radius);
    padding: 8px 12px;
}

.label {
    color: var(--text);
    font-size: 16px;
    margin: 0;
    padding: 0;
}

.label--dim {
    color: var(--text-dim);
    font-size: 13px;
}

.label--title {
    font-size: 18px;
    -unity-font-style: bold;
}

.label--small {
    font-size: 13px;
}

.label--negative {
    color: var(--negative);
}

/* ---------- Top bar ---------- */

.top-bar {
    position: absolute;
    left: var(--edge);
    top: var(--edge);
}

.top-bar__content {
    flex-direction: row;
    align-items: center;
}

.top-bar__resources {
    flex-direction: row;
}

.top-bar__item {
    margin-right: 24px;
}

/* ---------- Build menu ---------- */

.build-menu {
    position: absolute;
    left: var(--edge);
    bottom: var(--edge);
}

.build-menu__buttons {
    flex-direction: row;
}

.build-button {
    background-color: var(--button-bg);
    border-width: 2px;
    border-color: var(--panel-border);
    border-radius: var(--radius);
    padding: 8px 14px;
    margin: 0 8px 0 0;
    min-width: 110px;
    align-items: flex-start;
}

.build-button:hover {
    background-color: var(--button-hover);
}

.build-button:disabled {
    opacity: 0.45;
}

.build-button--active {
    border-color: var(--accent);
}

/* ---------- Building info ---------- */

/* Positioned every frame by BuildingInfoWidget; translate puts its bottom-center on the building. */
.info-panel {
    position: absolute;
    translate: -50% -100%;
    width: 260px;
}

.info-panel__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.close-button {
    width: 22px;
    height: 22px;
    margin: 0;
    padding: 0;
    background-color: var(--button-bg);
    border-width: 0;
    border-radius: 4px;
    color: var(--text);
    -unity-text-align: middle-center;
}

.close-button:hover {
    background-color: var(--button-hover);
}

/* ---------- Progress row ---------- */

.progress-row {
    margin-top: 6px;
}

.progress-bar {
    height: 8px;
    margin-top: 3px;
    background-color: var(--bar-bg);
    border-radius: 3px;
    overflow: hidden;
}

.progress-bar__fill {
    height: 100%;
    width: 0;
    background-color: var(--bar-fill);
}

/* ---------- Info row ---------- */

.info-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
}

.info-row__value {
    -unity-text-align: middle-right;
}
